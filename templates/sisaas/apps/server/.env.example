# Copy to apps/server/.env for local dev. The docker infra (infra/) provides
# postgres on host port 5434, redis on 6381, minio on 9000 — all off the
# defaults, because a developer machine usually already runs those.

NODE_ENV=development
PORT=8080

# si:when-begin multi-tenant
# Postgres — three roles (see infra/postgres/initdb/01-init.sql):
#   DATABASE_URL           runtime, RLS-constrained `simbkit_app` role (NOBYPASSRLS)
#   MIGRATION_DATABASE_URL owner `simbkit_owner` role (creates tables + RLS policies).
#                          NOT the superuser: superusers bypass RLS, which would
#                          make FORCE ROW LEVEL SECURITY decorative.
#   ADMIN_DATABASE_URL     `simbkit_admin` role (BYPASSRLS, super-admin realm)
# si:when-end
# si:when-begin single-tenant
# Postgres — two roles (see infra/postgres/initdb/01-init.sql):
#   DATABASE_URL           runtime `simbkit_app` role. Owns nothing, so it cannot
#                          drop or alter a table even if the API is compromised.
#   MIGRATION_DATABASE_URL owner `simbkit_owner` role, which creates the schema.
# si:when-end
DATABASE_URL=postgres://simbkit_app:simbkit_app_dev_pwd@localhost:5434/simbkit
MIGRATION_DATABASE_URL=postgres://simbkit_owner:simbkit_owner_dev_pwd@localhost:5434/simbkit
ADMIN_DATABASE_URL=postgres://simbkit_admin:simbkit_admin_dev_pwd@localhost:5434/simbkit # si:when multi-tenant

# Redis — cache + BullMQ queues. Unset → cache no-ops, single-node sockets.
REDIS_URL=redis://:simbkit_dev_pwd@localhost:6381

SERVICE_NAME=simbkit

# si:profile-begin identity,service
# Kafka — inter-service events. The dev stack runs Redpanda (Kafka-compatible).
# Unset → the worker's consumer never starts. Publishing is unaffected: services
# write to the outbox table and Debezium publishes, so a missing broker can never
# fail a domain write.
KAFKA_BROKERS=localhost:19092
# KAFKA_CONSUMER_GROUP=simbkit
# KAFKA_SSL=false
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# si:profile-end

# Auth. Generate real values with:  openssl rand -base64 48
# The app refuses to boot on anything shorter than 32 chars, and `pnpm verify:security`
# fails the build if these dev placeholders reach a production config.
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789

# Field-level encryption at rest. Losing this makes every encrypted column
# unrecoverable — back it up somewhere the database backup is not.
ENCRYPTION_KEY=dev_encryption_key_change_me_0123456789

# Object storage (MinIO / S3). Unset → in-memory stub adapter.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=simbkit
S3_SECRET_KEY=simbkit_dev_pwd
S3_BUCKET=simbkit
S3_FORCE_PATH_STYLE=true

# Public URLs / domains
WEB_PUBLIC_URL=http://localhost:3100
ROOT_DOMAIN=simbkit.local

# SMTP (optional; unset → mailer no-ops). Mailpit dev: host localhost, port 1025.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=no-reply@simbkit.local
# SMTP_FROM_NAME=Simbkit

# Web Push VAPID (optional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@simbkit.local
