import { checkPassword, DEFAULT_POLICY, pwnedPrefix } from './password-policy';

const ok = (p: string, ctx: string[] = []) => checkPassword(p, ctx).ok;

describe('password policy', () => {
  it('accepts a long passphrase with no special characters', () => {
    // The point of dropping composition rules: this is stronger than
    // `Password1!` and every classic checker rejects it.
    expect(ok('correct horse battery staple')).toBe(true);
  });

  it('rejects anything shorter than 12', () => {
    // Eight characters is a few hours on rented hardware.
    expect(ok('Sh0rt!1a')).toBe(false);
  });

  it('rejects the passwords attackers try first', () => {
    for (const p of ['password1234', 'motdepasse12', 'qwerty123456']) {
      expect(ok(p)).toBe(false);
    }
  });

  it('rejects a common password with decoration', () => {
    // `Password2024!` satisfies every composition rule ever written.
    expect(ok('Password2024!')).toBe(false);
    expect(ok('p@ssw0rd-2026')).toBe(false);
  });

  it('rejects a password built from the account it protects', () => {
    expect(ok('mariedupont2026', ['marie.dupont@mairie.cm'])).toBe(false);
    expect(ok('douala-mairie-99', ['douala-mairie'])).toBe(false);
  });

  it('rejects repetition and sequences that pass a length check', () => {
    expect(ok('aaaaaaaaaaaaaa')).toBe(false);
    expect(ok('0123456789abcd')).toBe(false);
  });

  it('bounds the length, because the hash runs on our CPU', () => {
    // An unbounded password is an argon2 call whose cost the attacker picks.
    expect(ok('a'.repeat(DEFAULT_POLICY.maxLength + 1) + 'Zx9')).toBe(false);
  });

  it('gives a reason a person can act on', () => {
    const verdict = checkPassword('short');
    expect(verdict.ok).toBe(false);
    if (!verdict.ok) expect(verdict.reason).toMatch(/at least 12/);
  });

  it('only ever exposes the first five hash characters', () => {
    // k-anonymity: the password itself never leaves the machine, and even the
    // prefix is opt-in on a sovereign deployment.
    const { prefix, suffix } = pwnedPrefix('correct horse battery staple');
    expect(prefix).toHaveLength(5);
    expect(prefix + suffix).toHaveLength(40);
    expect(prefix).toMatch(/^[0-9A-F]{5}$/);
  });
});
