# Cluster inventory. GENERATED by the control plane — edit there, not here.
#
# It is committed so the cluster can be rebuilt from the repository alone, and so
# a change to its shape shows up in a diff.
#
# The three SIMBKIT_WORKER_* lists are index-aligned: entry N of each describes
# the same node. The control plane keeps them that way; the scripts assert it and
# refuse to run if they ever drift.

SIMBKIT_SSH_USER=root
# Set SIMBKIT_SSH_PASSWORD for password auth (needs sshpass), otherwise a key is used.
SIMBKIT_SSH_KEY=~/.ssh/id_ed25519

SIMBKIT_CONTROL_PLANE_IP=203.0.113.10
SIMBKIT_CONTROL_PLANE_NAME=simbkit-cp-01
SIMBKIT_CONTROL_PLANE_WG_IP=10.89.0.1

SIMBKIT_WORKER_IPS="203.0.113.11 203.0.113.12"
SIMBKIT_WORKER_NAMES="simbkit-wk-01 simbkit-wk-02"
SIMBKIT_WORKER_WG_IPS="10.89.0.2 10.89.0.3"

SIMBKIT_WG_CIDR=10.89.0.0/24
SIMBKIT_WG_PORT=51820
SIMBKIT_K3S_FLANNEL_IFACE=wg0
SIMBKIT_K3S_VERSION=v1.34.1+k3s1
