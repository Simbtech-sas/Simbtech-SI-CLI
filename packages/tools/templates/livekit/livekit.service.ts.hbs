import { Injectable } from '@nestjs/common';
import { AccessToken, RoomServiceClient } from 'livekit-server-sdk';
import { AppConfigService } from '../../config/app-config.service';

/**
{{#if multiTenant}} * LiveKit rooms, scoped to a tenant.
{{else}} * LiveKit rooms.
{{/if}}
 *
{{#if multiTenant}} * Room names are prefixed with the tenant id and the prefix is applied here, not
{{else}} * Which room a caller may join is decided by the guard on the route that issues
{{/if}}
{{#if multiTenant}} * by callers — a token is a bearer credential, so a caller that could pass a raw
{{else}} * the token. A token is a bearer credential: once handed out it is good for that
{{/if}}
{{#if multiTenant}} * room name could join another tenant's call.
{{else}} * room until it expires, so issue it only after checking.
{{/if}}
 */
@Injectable()
export class LivekitService {
  private readonly url: string;
  private readonly apiKey: string;
  private readonly apiSecret: string;

  constructor(config: AppConfigService) {
    this.url = process.env['LIVEKIT_URL'] ?? '';
    this.apiKey = process.env['LIVEKIT_API_KEY'] ?? '';
    this.apiSecret = process.env['LIVEKIT_API_SECRET'] ?? '';
    void config;
  }

{{#if multiTenant}}  private roomName(tenantId: string, room: string): string {
{{else}}  private roomName(room: string): string {
{{/if}}
{{#if multiTenant}}    return `${tenantId}:${room}`;
{{else}}    return room;
{{/if}}
  }

{{#if multiTenant}}  /** A join token for one participant in one tenant's room. Expires in an hour. */
{{else}}  /** A join token for one participant in one room. Expires in an hour. */
{{/if}}
  async createToken(input: {
{{#if multiTenant}}    tenantId: string;
{{/if}}
    room: string;
    identity: string;
    name?: string;
    canPublish?: boolean;
  }): Promise<string> {
    const token = new AccessToken(this.apiKey, this.apiSecret, {
      identity: input.identity,
      name: input.name,
      ttl: '1h',
    });
    token.addGrant({
{{#if multiTenant}}      room: this.roomName(input.tenantId, input.room),
{{else}}      room: this.roomName(input.room),
{{/if}}
      roomJoin: true,
      canPublish: input.canPublish ?? true,
      canSubscribe: true,
    });
    return token.toJwt();
  }

  private get client(): RoomServiceClient {
    // LiveKit's REST API is http(s), while clients connect over ws(s).
    const httpUrl = this.url.replace(/^ws/, 'http');
    return new RoomServiceClient(httpUrl, this.apiKey, this.apiSecret);
  }

{{#if multiTenant}}  async listRooms(tenantId: string) {
{{else}}  async listRooms() {
{{/if}}
    const rooms = await this.client.listRooms();
{{#if multiTenant}}    return rooms.filter((r) => r.name.startsWith(`${tenantId}:`));
{{else}}    return rooms;
{{/if}}
  }

{{#if multiTenant}}  async deleteRoom(tenantId: string, room: string): Promise<void> {
{{else}}  async deleteRoom(room: string): Promise<void> {
{{/if}}
{{#if multiTenant}}    await this.client.deleteRoom(this.roomName(tenantId, room));
{{else}}    await this.client.deleteRoom(this.roomName(room));
{{/if}}
  }
}
