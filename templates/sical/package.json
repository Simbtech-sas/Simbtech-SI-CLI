{
  "name": "simbkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run verify:offline",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:offline": "node scripts/verify-offline.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "verify:security": "bash scripts/verify-security.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
