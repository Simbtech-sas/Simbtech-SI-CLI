import { nextPeriodEnd, stepFor, DUNNING_SCHEDULE, GRACE_DAYS } from './dunning';

describe('billing period arithmetic', () => {
  it('adds a month', () => {
    expect(nextPeriodEnd(new Date('2026-01-15T00:00:00Z'), 'month').toISOString()).toBe(
      '2026-02-15T00:00:00.000Z',
    );
  });

  it('clamps the 31st to the last day of a shorter month', () => {
    // Naive month arithmetic turns 31 Jan into 3 March, and a subscription
    // started on the 31st then drifts forward every short month.
    expect(nextPeriodEnd(new Date('2026-01-31T00:00:00Z'), 'month').toISOString()).toBe(
      '2026-02-28T00:00:00.000Z',
    );
    expect(nextPeriodEnd(new Date('2026-03-31T00:00:00Z'), 'month').toISOString()).toBe(
      '2026-04-30T00:00:00.000Z',
    );
  });

  it('handles a leap year', () => {
    expect(nextPeriodEnd(new Date('2028-01-31T00:00:00Z'), 'month').toISOString()).toBe(
      '2028-02-29T00:00:00.000Z',
    );
  });

  it('adds a year', () => {
    expect(nextPeriodEnd(new Date('2026-06-15T00:00:00Z'), 'year').toISOString()).toBe(
      '2027-06-15T00:00:00.000Z',
    );
  });

  it('does not drift across twelve monthly renewals', () => {
    // The 15th must still be the 15th a year later.
    let date = new Date('2026-01-15T00:00:00Z');
    for (let i = 0; i < 12; i++) date = nextPeriodEnd(date, 'month');
    expect(date.toISOString()).toBe('2027-01-15T00:00:00.000Z');
  });
});

describe('dunning schedule', () => {
  it('is paced for a human, not a retry loop', () => {
    // A USSD prompt needs the customer awake, in coverage and holding their
    // phone. Hourly retries would be nagging, not collection.
    const gaps = DUNNING_SCHEDULE.map((s) => s.afterDays);
    expect(gaps).toEqual([...gaps].sort((a, b) => a - b));
    expect(GRACE_DAYS).toBeGreaterThanOrEqual(7);
  });

  it('suspends only at the end of the schedule', () => {
    const suspend = DUNNING_SCHEDULE.filter((s) => s.action === 'suspend');
    expect(suspend).toHaveLength(1);
    expect(suspend[0]!.afterDays).toBe(GRACE_DAYS);
  });

  it('picks the latest due step, so a missed run catches up', () => {
    // A job that did not run for three days must not replay every earlier step
    // and send three emails at once.
    expect(stepFor(0, 0)?.action).toBe('request-again');
    expect(stepFor(3, 0)?.afterDays).toBe(2);
    expect(stepFor(6, 0)?.afterDays).toBe(5);
    expect(stepFor(10, 0)?.action).toBe('suspend');
  });

  it('returns nothing before the first step is due', () => {
    expect(stepFor(-1, 0)).toBeNull();
  });

  it('suspends once the attempts are exhausted, whatever the day count', () => {
    // Bounded: a subscription cannot be dunned forever because a job kept
    // retrying.
    expect(stepFor(1, DUNNING_SCHEDULE.length)?.action).toBe('suspend');
  });
});
