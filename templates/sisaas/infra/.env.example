# Copy to infra/.env to override the dev defaults baked into docker-compose.yml.
# Compose auto-loads infra/.env (it sits next to the compose file).
# These are DEV-ONLY credentials — never reuse them anywhere real.

POSTGRES_USER=simbkit
POSTGRES_PASSWORD=simbkit_dev_pwd
POSTGRES_DB=simbkit
POSTGRES_HOST_PORT=5434

REDIS_PASSWORD=simbkit_dev_pwd

MINIO_ROOT_USER=simbkit
MINIO_ROOT_PASSWORD=simbkit_dev_pwd
