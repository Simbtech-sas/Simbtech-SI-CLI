# Build-time, not runtime. These are compiled into the binary:
#
#   SIMBKIT_LICENCE_PUBLIC_KEY=<public hex from `npm run licence:keygen`>
#   SIMBKIT_MODE=standalone | lan-server | cloud-sync
#
# Only the PUBLIC key belongs here. The private half stays on your signing
# machine and never enters this repository.
SIMBKIT_MODE=standalone
