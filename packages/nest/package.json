{
  "name": "@simbtech/si-nest",
  "version": "0.1.0",
  "description": "Backend code generation for si \u2014 field specs, naming, and the generators behind `si scaffold`",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@simbtech/si-core": "workspace:*",
    "handlebars": "^4.7.8",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pluralize": "^0.0.33",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SIMBTECH-SAS/boilerplates.git",
    "directory": "packages/nest"
  },
  "homepage": "https://github.com/SIMBTECH-SAS/boilerplates#readme",
  "bugs": {
    "url": "https://github.com/SIMBTECH-SAS/boilerplates/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
