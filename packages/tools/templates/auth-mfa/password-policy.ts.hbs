import { createHash } from 'node:crypto';

/**
 * What counts as an acceptable password.
 *
 * Deliberately NOT the classic "one uppercase, one digit, one symbol" rule.
 * That rule is why `Password1!` exists: it produces predictable passwords that
 * satisfy a checker and fall to a dictionary in seconds. NIST 800-63B dropped
 * composition rules for exactly this reason.
 *
 * What is enforced instead is what actually resists guessing: length, and not
 * being one of the passwords everybody already tried.
 */
export interface PasswordPolicy {
  minLength: number;
  maxLength: number;
  /** Reject a password containing the user's own email, name or tenant slug. */
  rejectContextual: boolean;
  /** Reject anything in the bundled common-password list. */
  rejectCommon: boolean;
}

export const DEFAULT_POLICY: PasswordPolicy = {
  // 12, not 8. Eight characters is a few hours on rented hardware.
  minLength: 12,
  // Bounded because the hash runs on our CPU: an unbounded password is an
  // argon2 call an attacker chooses the cost of.
  maxLength: 200,
  rejectContextual: true,
  rejectCommon: true,
};

/**
 * The passwords attackers try first.
 *
 * A deliberately small bundled list, not a 10-million-line corpus: the top few
 * hundred cover the overwhelming majority of credential-stuffing attempts, and
 * shipping a 100MB file to reject `qwerty` is a poor trade. Point
 * `COMMON_PASSWORDS` at a fuller list if you have one — the check is the same.
 */
export const COMMON_PASSWORDS: ReadonlySet<string> = new Set([
  'password', 'password1', 'password123', '123456', '12345678', '123456789',
  '1234567890', 'qwerty', 'qwerty123', 'azerty', 'abc123', 'letmein', 'welcome',
  'monkey', 'dragon', 'football', 'iloveyou', 'admin', 'admin123', 'root',
  'toor', 'pass', 'test', 'guest', 'changeme', 'secret', 'motdepasse',
  'bonjour', 'soleil', 'default', 'passw0rd', 'p@ssw0rd', 'zaq12wsx',
  'trustno1', 'sunshine', 'princess', 'master', 'shadow', 'superman',
]);

export type PasswordVerdict = { ok: true } | { ok: false; reason: string };

/**
 * @param context Anything the password must not contain — email, display name,
 *   tenant slug. A password built from the account it protects is guessable by
 *   whoever knows the account.
 */
export function checkPassword(
  password: string,
  context: string[] = [],
  policy: PasswordPolicy = DEFAULT_POLICY,
): PasswordVerdict {
  if (password.length < policy.minLength) {
    return { ok: false, reason: `must be at least ${policy.minLength} characters` };
  }
  if (password.length > policy.maxLength) {
    return { ok: false, reason: `must be at most ${policy.maxLength} characters` };
  }

  const normalised = password.toLowerCase().trim();

  if (policy.rejectCommon) {
    if (COMMON_PASSWORDS.has(normalised)) {
      return { ok: false, reason: 'this is one of the most commonly used passwords' };
    }
    // `Password2024!` and `p@ssw0rd` are both `password`. Undo the two things
    // people do to get a common word past a checker: substitution and padding.
    // Checking only the literal string is why those two are the most common
    // passwords that pass composition rules.
    const candidates = new Set([
      normalised.replace(/[^a-z]/g, ''),
      unleet(normalised).replace(/[^a-z]/g, ''),
    ]);
    for (const candidate of candidates) {
      if (candidate.length >= 4 && COMMON_PASSWORDS.has(candidate)) {
        return { ok: false, reason: 'this is a common password with characters added' };
      }
      // Exact match is not enough. `p@ssw0rd-2026` unleets to `passwordo`,
      // because `0` is both padding and a substitute for `o` and stripping it
      // loses the word either way. So look for a common password INSIDE the
      // candidate — bounded by length, or a genuine passphrase that happens to
      // contain `dragon` would be refused for no reason.
      for (const common of COMMON_PASSWORDS) {
        if (
          common.length >= 6 &&
          candidate.includes(common) &&
          candidate.length <= common.length + 4
        ) {
          return { ok: false, reason: 'this is a common password with characters added' };
        }
      }
    }
  }

  if (policy.rejectContextual) {
    // Compared on letters and digits alone, both sides. `marie.dupont` and
    // `mariedupont2026` are the same secret to anyone who knows the account,
    // and a literal `includes` misses it over one full stop.
    const flat = normalised.replace(/[^a-z0-9]/g, '');
    for (const item of context) {
      for (const part of item.toLowerCase().split(/[@\s]+/)) {
        const needle = part.replace(/[^a-z0-9]/g, '');
        if (needle.length >= 4 && flat.includes(needle)) {
          return { ok: false, reason: 'must not contain your name, email or workspace' };
        }
      }
    }
  }

  // A single repeated character passes a length check and nothing else.
  if (/^(.)\1+$/.test(password)) {
    return { ok: false, reason: 'must not be a single repeated character' };
  }
  if (/^(?:0123456789|abcdefghij|qwertyuiop)/i.test(normalised)) {
    return { ok: false, reason: 'must not be a keyboard or alphabet sequence' };
  }

  return { ok: true };
}

/**
 * Undo the usual character substitutions.
 *
 * Not a general leetspeak decoder — just the handful that turn a dictionary
 * word into something a composition rule accepts.
 */
function unleet(value: string): string {
  return value
    .replace(/[@4]/g, 'a')
    .replace(/[3]/g, 'e')
    .replace(/[1!|]/g, 'l')
    .replace(/[0]/g, 'o')
    .replace(/[5$]/g, 's')
    .replace(/[7]/g, 't');
}

/**
 * The k-anonymity prefix for Have I Been Pwned, for deployments that allow it.
 *
 * Only the FIRST FIVE characters of the hash leave the machine, and the range
 * response is searched locally — the password itself never goes anywhere. Even
 * so this is opt-in: on a sovereign deployment any outbound call is a decision
 * somebody has to make, not a default somebody discovers.
 */
export function pwnedPrefix(password: string): { prefix: string; suffix: string } {
  const hash = createHash('sha1').update(password).digest('hex').toUpperCase();
  return { prefix: hash.slice(0, 5), suffix: hash.slice(5) };
}
