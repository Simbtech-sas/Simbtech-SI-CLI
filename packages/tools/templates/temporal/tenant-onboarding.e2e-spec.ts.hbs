import path from 'node:path';
import { TestWorkflowEnvironment } from '@temporalio/testing';
import { Worker } from '@temporalio/worker';
import { tenantOnboarding } from '../../src/modules/temporal/workflows/tenant-onboarding.workflow';
import { EMAIL_VERIFIED_SIGNAL } from '../../src/modules/temporal/domain/workflow-signals';

/**
 * The workflow, against a REAL Temporal server.
 *
 * `createTimeSkipping` starts Temporal's test server, which fast-forwards its
 * own clock whenever every workflow is asleep. That is what makes a seven-day
 * timer testable in a second — and it is the only way to prove a durable timer
 * actually fires, rather than proving that a mock was called.
 *
 * The first run downloads the test server binary, so this lives in the e2e
 * suite rather than the one that runs on every save.
 */
jest.setTimeout(120_000);

describe('tenant onboarding', () => {
  let env: TestWorkflowEnvironment;
  const published: unknown[][] = [];

  beforeAll(async () => {
    env = await TestWorkflowEnvironment.createTimeSkipping();
  });
  afterAll(async () => env?.teardown());

  /**
   * Activities are stubbed, workflow code is not. The workflow is what is under
   * test; the activities are already covered by the outbox's own tests, and
   * running them here would need a database for no extra confidence.
   */
  const worker = () =>
    Worker.create({
      connection: env.nativeConnection,
      taskQueue: 'test',
      workflowsPath: path.resolve(__dirname, '../../src/modules/temporal/workflows/index.ts'),
      activities: {
        async publishTenantActivated(context: { tenantId: string }) {
          published.push(['activated', context.tenantId]);
        },
        async publishOnboardingAbandoned(_context: unknown, step: string) {
          published.push(['abandoned', step]);
        },
      },
    });

  it('gives up after the verification window, and calls it abandoned rather than failed', async () => {
    // Nothing broke — the customer walked away. A consumer should archive this,
    // not alert on it, which is why it is a distinct event.
    const w = await worker();
    const result = await w.runUntil(
      env.client.workflow.execute(tenantOnboarding, {
        workflowId: 'tenant-a:onboarding:tenant-a',
        taskQueue: 'test',
        args: [{ tenantId: '11111111-1111-1111-1111-111111111111', tenantName: 'A' }],
      }),
    );
    expect(result).toBe('abandoned');
    expect(published.at(-1)).toEqual(['abandoned', 'email-verification']);
  });

  it('wakes on the signal and activates', async () => {
    const w = await worker();
    const result = await w.runUntil(async () => {
      const handle = await env.client.workflow.start(tenantOnboarding, {
        workflowId: 'tenant-b:onboarding:tenant-b',
        taskQueue: 'test',
        args: [{ tenantId: '22222222-2222-2222-2222-222222222222', tenantName: 'B' }],
      });
      await handle.signal(EMAIL_VERIFIED_SIGNAL);
      return handle.result();
    });
    expect(result).toBe('activated');
    expect(published.at(-1)).toEqual(['activated', '22222222-2222-2222-2222-222222222222']);
  });

  it('refuses to start a second run for the same workflow id', async () => {
    // This is what makes an at-least-once Kafka event safe to act on: a
    // redelivery finds the run already going instead of starting a second
    // seven-day process with a second welcome email.
    const w = await worker();
    await w.runUntil(async () => {
      const handle = await env.client.workflow.start(tenantOnboarding, {
        workflowId: 'tenant-c:onboarding:tenant-c',
        taskQueue: 'test',
        args: [{ tenantId: '33333333-3333-3333-3333-333333333333', tenantName: 'C' }],
      });
      await expect(
        env.client.workflow.start(tenantOnboarding, {
          workflowId: 'tenant-c:onboarding:tenant-c',
          taskQueue: 'test',
          args: [{ tenantId: '33333333-3333-3333-3333-333333333333', tenantName: 'C' }],
        }),
      ).rejects.toThrow(/already started/i);
      await handle.signal(EMAIL_VERIFIED_SIGNAL);
      await handle.result();
    });
  });
});
