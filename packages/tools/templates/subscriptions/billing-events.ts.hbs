import { z } from 'zod';
import { defineEvent, type EventContract } from './contract.ts';

/**
 * What billing announces.
 *
 * These carry `billingEmail` and `accountName` on the payload rather than making
 * consumers look them up. In a single deployable that looks redundant; across
 * services it is the difference between a notification service that needs a
 * synchronous call into identity on every message — and a broker outage taking
 * the mail with it — and one that does not.
 *
 * The cost is real and worth naming: an email address is personal data now
 * sitting in a Kafka topic. Set finite retention on `{{brand}}.billing.v1` and
 * keep it off any compacted topic. Nothing here carries a phone number, an
 * address, or anything about what the customer bought beyond the plan name.
 */
const billingBase = z.object({
  subscriptionId: z.string().uuid(),
  planName: z.string(),
  /** Decimal string in major units. Never a float. */
  amount: z.string(),
  currency: z.string().length(3),
  accountName: z.string(),
  billingEmail: z.string().email().nullable(),
});

export const TrialEnding = defineEvent({
  service: '{{brand}}',
  aggregate: 'billing',
  type: 'TrialEnding',
  version: 1,
  schema: billingBase.extend({ daysLeft: z.number().int().positive() }),
});

/**
 * The customer is being asked to pay. Emitted at every `request-again` step of
 * the dunning schedule, with `attempt` counting up — a consumer can tell a first
 * notice from a third reminder without keeping its own count.
 */
export const SubscriptionPaymentRequested = defineEvent({
  service: '{{brand}}',
  aggregate: 'billing',
  type: 'SubscriptionPaymentRequested',
  version: 1,
  schema: billingBase.extend({
    invoiceId: z.string().uuid().optional(),
    invoiceNumber: z.string().optional(),
    dueDate: z.string(),
    attempt: z.number().int().min(1),
    daysUntilSuspension: z.number().int().min(0),
    /** Absent for a USSD push — there is nothing to click. */
    payUrl: z.string().url().optional(),
  }),
});

export const SubscriptionPaymentFailed = defineEvent({
  service: '{{brand}}',
  aggregate: 'billing',
  type: 'SubscriptionPaymentFailed',
  version: 1,
  schema: billingBase.extend({
    reason: z.string().nullable().optional(),
    daysUntilSuspension: z.number().int().min(0),
    payUrl: z.string().url().optional(),
  }),
});

/** Access off, data kept. Consumers must not read this as "delete their stuff". */
export const SubscriptionSuspended = defineEvent({
  service: '{{brand}}',
  aggregate: 'billing',
  type: 'SubscriptionSuspended',
  version: 1,
  schema: billingBase.extend({ payUrl: z.string().url().optional() }),
});

export const SubscriptionRenewed = defineEvent({
  service: '{{brand}}',
  aggregate: 'billing',
  type: 'SubscriptionRenewed',
  version: 1,
  schema: billingBase.extend({
    periodStart: z.string().datetime({ offset: true }),
    periodEnd: z.string().datetime({ offset: true }),
  }),
});

export const SubscriptionCancelled = defineEvent({
  service: '{{brand}}',
  aggregate: 'billing',
  type: 'SubscriptionCancelled',
  version: 1,
  schema: billingBase.extend({ endedAt: z.string().datetime({ offset: true }) }),
});

const invoiceBase = billingBase.extend({
  invoiceId: z.string().uuid(),
  number: z.string(),
});

export const InvoiceIssued = defineEvent({
  service: '{{brand}}',
  aggregate: 'billing',
  type: 'InvoiceIssued',
  version: 1,
  schema: invoiceBase.extend({ dueDate: z.string(), payUrl: z.string().url().optional() }),
});

/** Money actually arrived. This is what a receipt is sent for, and what a ledger posts. */
export const InvoicePaid = defineEvent({
  service: '{{brand}}',
  aggregate: 'billing',
  type: 'InvoicePaid',
  version: 1,
  schema: invoiceBase.extend({
    paidAt: z.string().datetime({ offset: true }),
    paymentReference: z.string(),
  }),
});

export const BILLING_EVENTS = {
  TrialEnding,
  SubscriptionPaymentRequested,
  SubscriptionPaymentFailed,
  SubscriptionSuspended,
  SubscriptionRenewed,
  SubscriptionCancelled,
  InvoiceIssued,
  InvoicePaid,
} as const satisfies Record<string, EventContract>;
