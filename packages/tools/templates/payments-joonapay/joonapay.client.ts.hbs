import { Injectable, Logger } from '@nestjs/common';
import { AppConfigService } from '../../../config/app-config.service';
import type { JoonapayEnvelope } from './joonapay.types';

export class JoonapayError extends Error {
  constructor(
    readonly status: number,
    message: string,
    /** JoonaPay's own code — `IDEMPOTENCY_KEY_CONFLICT`, `VALIDATION_ERROR`… */
    readonly code?: string,
    readonly details?: Record<string, unknown>,
    /** Quote this to JoonaPay support; it identifies the exact call. */
    readonly requestId?: string,
  ) {
    super(message);
    this.name = 'JoonapayError';
  }

  /**
   * A 409 is a GUARD, not a failure. Nothing was created, and retrying the same
   * call unchanged will keep returning it. Either reuse the original operation
   * or issue a genuinely new idempotency key.
   */
  get isConflict(): boolean {
    return this.status === 409;
  }

  get isTransient(): boolean {
    return this.status === 429 || this.status >= 500;
  }
}

const MAX_ATTEMPTS = 4;

/**
 * HTTP transport for the JoonaPay Developer API.
 *
 * Three things about this API drive the shape of this class:
 *
 * 1. **The envelope decides, not the HTTP status.** Every response carries
 *    `success`, and `success: false` can arrive with a 200.
 * 2. **60 requests per minute**, lower than most. 429 is expected traffic, not
 *    an incident, so it is retried with the server's own `Retry-After`.
 * 3. **IP whitelisting.** A 403 here almost never means bad keys — it means the
 *    machine's egress IP is not registered. Saying so saves an afternoon.
 */
@Injectable()
export class JoonapayClient {
  private readonly log = new Logger(JoonapayClient.name);
  private readonly baseUrl: string;
  private readonly clientKey: string;
  private readonly privateKey: string;
  /** False when no keys are set. The module still loads; it just cannot charge. */
  readonly configured: boolean;

  constructor(private readonly config: AppConfigService) {
    const joonapay = config.joonapay;

    // Installed-but-unconfigured is the normal state on day one, and it must
    // not stop the API from booting. Throwing here takes down auth, uploads and
    // everything else because a payment key is missing — so this stays inert and
    // `call()` refuses instead, where the failure belongs.
    this.configured = joonapay !== null;
    if (!joonapay) {
      this.baseUrl = '';
      this.clientKey = '';
      this.privateKey = '';
      this.log.warn('JOONAPAY_CLIENT_KEY / JOONAPAY_PRIVATE_KEY are not set — JoonaPay is inactive');
      return;
    }

    this.baseUrl = joonapay.baseUrl.replace(/\/+$/, '');
    this.clientKey = joonapay.clientKey;
    this.privateKey = joonapay.privateKey;

    // Same trap as every other gateway: the key prefix, not the URL, decides
    // whether real money moves. There is one production base URL.
    const isLive = this.clientKey.startsWith('pk_live_');
    if (isLive && !config.isProduction) {
      throw new Error(
        'a pk_live_ JoonaPay key is configured outside production — this would move real money. ' +
          'Use a test key, or set NODE_ENV=production deliberately.',
      );
    }
    if (!isLive && config.isProduction) {
      this.log.warn('running in production with a JoonaPay TEST key — no real payment will settle');
    }
  }

  get isLive(): boolean {
    return this.clientKey.startsWith('pk_live_');
  }

  /**
   * @param idempotencyKey Send the SAME key when retrying the same operation.
   *   A new key on a retry creates a second payout. This is the only defence
   *   against a lost response after a timeout.
   */
  async call<T>(
    method: 'GET' | 'POST',
    path: string,
    body?: unknown,
    idempotencyKey?: string,
  ): Promise<T> {
    if (!this.configured) {
      throw new JoonapayError(503, 'JoonaPay is not configured', 'NOT_CONFIGURED');
    }
    if (idempotencyKey && idempotencyKey.length > 255) {
      // JoonaPay answers 422 IDEMPOTENCY_KEY_TOO_LONG. Failing here costs one
      // less round trip and is unambiguous.
      throw new JoonapayError(422, 'idempotency key exceeds 255 characters', 'IDEMPOTENCY_KEY_TOO_LONG');
    }

    let lastError: JoonapayError | undefined;

    for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
      const res = await fetch(`${this.baseUrl}${path}`, {
        method,
        headers: {
          'X-Client-Key': this.clientKey,
          'X-Private-Key': this.privateKey,
          accept: 'application/json',
          ...(idempotencyKey ? { 'Idempotency-Key': idempotencyKey } : {}),
          ...(body === undefined ? {} : { 'content-type': 'application/json' }),
        },
        body: body === undefined ? undefined : JSON.stringify(body),
        signal: AbortSignal.timeout(20_000),
      });

      const text = await res.text();
      let parsed: JoonapayEnvelope<T> | null = null;
      try {
        parsed = text.length > 0 ? (JSON.parse(text) as JoonapayEnvelope<T>) : null;
      } catch {
        /* not JSON — a proxy or an outage page */
      }

      if (res.ok && parsed?.success) {
        if (res.headers.get('idempotent-replay') === 'true') {
          // Not an error: the original operation is being returned unchanged.
          // Worth a log line, because it means an earlier response was lost.
          this.log.log(`JoonaPay replayed an idempotent ${method} ${path}`);
        }
        return parsed.data as T;
      }

      const code = parsed?.errors?.code;
      const message =
        parsed?.message ??
        (res.status === 403
          ? 'JoonaPay refused the request — the caller IP is probably not whitelisted'
          : `JoonaPay ${method} ${path} failed`);

      lastError = new JoonapayError(
        // A `success: false` inside a 200 still has to fail.
        res.ok ? 502 : res.status,
        message,
        code,
        parsed?.errors?.details,
        parsed?.metadata?.request_id,
      );

      if (!lastError.isTransient || attempt === MAX_ATTEMPTS) throw lastError;

      // On PAYOUT_CREATION_IN_PROGRESS the header says how long to wait; that is
      // the server's own estimate and beats any backoff guess.
      const retryAfter = Number(res.headers.get('retry-after'));
      const delay = Number.isFinite(retryAfter) && retryAfter > 0
        ? retryAfter * 1000
        : 1000 * 2 ** (attempt - 1);
      this.log.warn(`JoonaPay ${res.status} on ${path}, retrying in ${delay}ms`);
      await new Promise((r) => setTimeout(r, delay));
    }

    throw lastError ?? new JoonapayError(500, 'JoonaPay call failed');
  }
}
